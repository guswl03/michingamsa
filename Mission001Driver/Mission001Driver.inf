[Version]
Signature="$WINDOWS NT$"
Class=Sample
ClassGuid={78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider=%ProviderName%
DriverVer=08/01/2026,1.0.0.0
CatalogFile=Mission001Driver.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall.NTamd64]
CopyFiles = DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService = Mission001Driver,%SPSVCINST_ASSOCSERVICE%,ServiceInstall

[DriverCopyFiles]
Mission001Driver.sys

[ServiceInstall]
DisplayName    = %ServiceName%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\Mission001Driver.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName = "Mission001"
ServiceName = "Mission001 IOCTL Driver"

